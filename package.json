{
  "name": "claude-game-bar",
  "version": "1.0.0",
  "description": "A status bar for the Claude Code CLI that draws the session as a game HUD: usage, rate limits, model, project, agents, tasks and system, as DOOM or Minecraft.",
  "type": "module",
  "bin": {
    "claude-game-bar": "bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "assets",
    "tools"
  ],
  "scripts": {
    "statusline": "node src/statusline.js",
    "hook": "node src/hook.js",
    "skin": "node bin/cli.js skin",
    "theme": "node bin/cli.js theme",
    "compare-faces": "node scripts/compare-faces.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node test/e2e/daemon-e2e.test.mjs",
    "preversion": "npm test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "smol-toml": "^1.6.1"
  },
  "keywords": [
    "claude-code",
    "claude",
    "statusline",
    "statusbar",
    "status-bar",
    "hud",
    "terminal",
    "tui",
    "game",
    "doom",
    "minecraft"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99LevelsUp/claude-game-bar.git"
  },
  "homepage": "https://github.com/99LevelsUp/claude-game-bar#readme",
  "bugs": {
    "url": "https://github.com/99LevelsUp/claude-game-bar/issues"
  },
  "license": "MIT"
}
