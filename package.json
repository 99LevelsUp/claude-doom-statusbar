{
  "name": "claude-doom-statusbar",
  "version": "0.15.0",
  "description": "DOOM-inspired status bar for the Claude Code CLI — a mugshot that tracks session health, plus usage, model, project, system, and a live subagent list.",
  "type": "module",
  "bin": {
    "claude-doom-statusbar": "bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "presets",
    "assets",
    "tools"
  ],
  "scripts": {
    "statusline": "node src/statusline.js",
    "hook": "node src/hook.js",
    "theme": "node bin/cli.js theme",
    "compare-faces": "node scripts/compare-faces.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node test/e2e/daemon-e2e.test.mjs",
    "preversion": "npm test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "smol-toml": "^1.6.1"
  },
  "keywords": [
    "claude-code",
    "statusline",
    "doom",
    "terminal",
    "hud",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99LevelsUp/claude-doom-statusbar.git"
  },
  "license": "MIT"
}
